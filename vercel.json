{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "albert",
          "format": "url",
          "env": "ALBERT_URL"
        },
        {
          "type": "service",
          "service": "gpt",
          "format": "url",
          "env": "GPT_URL"
        }
      ]
    },
    "albert": {
      "root": "sources/Arabic-Poems-Generation/albert",
      "entrypoint": "Dockerfile.vercel"
    },
    "gpt": {
      "root": "sources/Arabic-Poems-Generation/gpt-2",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
